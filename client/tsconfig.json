{  
    "compilerOptions": {    
        "lib": ["dom", "dom.iterable", "ESNext"],    
        "target": "ESNext",    
        "types": ["vite/client"],
        "isolatedModules": true,
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "paths": {
            "rollup/parseAst": ["./node_modules/rollup/dist/parseAst"],
        }
    },
}
